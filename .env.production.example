# ==============================================================================
# PROJETO VTURB - VARIÁVEIS DE AMBIENTE PARA PRODUÇÃO (DOCKER COMPOSE)
# ==============================================================================
# Copie este arquivo para .env.production no servidor:
# cp .env.production.example .env.production
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BANCO DE DADOS (PostgreSQL em Produção) - [OBRIGATÓRIO]
# ------------------------------------------------------------------------------
# Informe a URL de conexão do seu PostgreSQL em produção (Cloud RDS, Supabase, Neon ou VPS)
# Formato: postgresql://<usuario>:<senha>@<host_ou_ip>:<porta>/<nome_do_banco>
DATABASE_URL=postgresql://vturb_user:sua_senha_segura_aqui@host_do_banco:5432/vturb_db

# ------------------------------------------------------------------------------
# 2. CONTA DO SUPER ADMINISTRADOR (Bootstrap Automático) - [OBRIGATÓRIO]
# ------------------------------------------------------------------------------
# Credenciais do administrador principal da plataforma.
# Criada ou sincronizada automaticamente no primeiro boot do contêiner backend.
SUPER_ADMIN_EMAIL=admin@seudominio.com
SUPER_ADMIN_PASSWORD=SuaSenhaForteSuperAdmin123!

# ------------------------------------------------------------------------------
# 3. AUTENTICAÇÃO E SEGURANÇA JWT (Argon2id + HS256) - [OBRIGATÓRIO]
# ------------------------------------------------------------------------------
# Chave secreta única para assinatura dos tokens JWT.
# DICA: Gere no terminal com `openssl rand -hex 32`
JWT_SECRET_KEY=gere_uma_chave_longa_e_super_segura_de_producao_2026_vturb
# Tempo de vida do token de sessão (ex: 24h ou 24)
JWT_ACCESS_TOKEN_EXPIRE_HOURS=24h

# ------------------------------------------------------------------------------
# 4. ARMAZENAMENTO EM NUVEM BACKBLAZE B2 / S3 - [OPCIONAL / RECOMENDADO]
# ------------------------------------------------------------------------------
# Credenciais para hospedagem de vídeos (.mp4), thumbnails e backups automatizados do banco.
# Se não configuradas, o sistema salvará uploads localmente na pasta /app/static/uploads.
BACKBLAZE_KEY_ID=005xxxxxxxxxxxx0000000001
BACKBLAZE_APPLICATION_KEY=K005xxxxxxxxxxxxxxxxxxxxxxxxxxx
BACKBLAZE_BUCKET_NAME=meu-bucket-vturb-producao
BACKBLAZE_ENDPOINT_URL=https://s3.us-east-005.backblazeb2.com
# URL pública de CDN (ex: Cloudflare com tráfego gratuito ou domínio personalizado)
BACKBLAZE_CDN_URL=https://videos.seudominio.com

# ------------------------------------------------------------------------------
# 5. DISPARO DE E-MAILS TRANSACIONAIS (Brevo API) - [OPCIONAL / RECOMENDADO]
# ------------------------------------------------------------------------------
# Utilizado para validação de e-mail ao aceitar convites e fluxo "Esqueci minha senha".
# Obtenha sua chave gratuita em https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_SENDER_EMAIL=noreply@seudominio.com
BREVO_SENDER_NAME="Clone do VTurb"

# ------------------------------------------------------------------------------
# 6. DOMÍNIOS E ROTAS DO TRAEFIK (Docker Swarm) - [OBRIGATÓRIO]
# ------------------------------------------------------------------------------
# Domínio público do Frontend e da API Backend gerenciados pelo Traefik
FRONTEND_DOMAIN=app.seudominio.com
BACKEND_DOMAIN=api.seudominio.com

# ------------------------------------------------------------------------------
# 7. CONFIGURAÇÃO DE COMUNICAÇÃO DO FRONTEND (Vite / React) - [OBRIGATÓRIO]
# ------------------------------------------------------------------------------
# URL pública acessível pelo navegador dos usuários para falar com o Backend.
# Exemplo em produção: https://api.seudominio.com
VITE_API_BASE_URL=https://api.seudominio.com

# ------------------------------------------------------------------------------
# 8. IMAGENS DOCKER DOS SERVIÇOS (Opcional se usar registry privado)
# ------------------------------------------------------------------------------
BACKEND_IMAGE=vturb-backend:latest
FRONTEND_IMAGE=vturb-frontend:latest
