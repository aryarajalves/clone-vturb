# ==============================================================================
# Dockerfile de Produção - Frontend (React + Vite + TypeScript + Nginx)
# ==============================================================================

# Estágio 1: Build da aplicação React
FROM node:20-alpine AS builder

WORKDIR /app

# Instalação das dependências
COPY frontend/package*.json ./
RUN npm ci || npm install

# Cópia do código-fonte do frontend
COPY frontend/ .

# Argumento para injetar a URL da API em tempo de build (opcional, pois o runtime config tem precedência)
ARG VITE_API_BASE_URL=""
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL


# Geração da build estática otimizada
RUN npm run build

# Estágio 2: Servidor Web Nginx ultra-leve de alta performance
FROM nginx:alpine

# Remoção da configuração padrão do Nginx
RUN rm -rf /etc/nginx/conf.d/default.conf

# Cópia da configuração customizada com suporte a SPA e gzip
COPY docker/frontend/nginx.conf /etc/nginx/conf.d/default.conf

# Cópia do script de injeção de variáveis de ambiente em tempo de execução (Runtime Config)
COPY docker/frontend/40-generate-env.sh /docker-entrypoint.d/40-generate-env.sh
RUN sed -i 's/\r$//' /docker-entrypoint.d/40-generate-env.sh && chmod +x /docker-entrypoint.d/40-generate-env.sh

# Cópia dos arquivos estáticos compilados pelo Vite
COPY --from=builder /app/dist /usr/share/nginx/html


EXPOSE 80

# Healthcheck do Nginx (utiliza 127.0.0.1 explícito para evitar problemas de resolução IPv6 do Alpine)
HEALTHCHECK --interval=15s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -qO- http://127.0.0.1/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
