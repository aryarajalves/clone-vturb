# [OBRIGATÓRIO] URL de conexão com o banco de dados PostgreSQL
DATABASE_URL=postgresql://vturb_user:vturb_password@localhost:5434/vturb_db

# [OPCIONAL - BACKBLAZE B2 OBJECT STORAGE]
# Credenciais para hospedagem de vídeos (.mp4) e capas diretamente no Backblaze B2
# Caso não configuradas, o sistema utiliza o armazenamento local em static/uploads/
BACKBLAZE_KEY_ID=005xxxxxxxxxxxx0000000001
BACKBLAZE_APPLICATION_KEY=K005xxxxxxxxxxxxxxxxxxxxxxxxxxx
BACKBLAZE_BUCKET_NAME=meu-bucket-vturb
BACKBLAZE_ENDPOINT_URL=https://s3.us-east-005.backblazeb2.com
# [OPCIONAL] URL pública de CDN (ex: Cloudflare com tráfego gratuito ou domínio próprio)
# Exemplo: https://videos.meudominio.com ou https://f005.backblazeb2.com/file/meu-bucket-vturb
BACKBLAZE_CDN_URL=https://f005.backblazeb2.com/file/meu-bucket-vturb

# [OBRIGATÓRIO] Credenciais do Super Administrador da Plataforma
# Utilizadas para inicializar e sincronizar automaticamente a conta super admin no banco de dados
SUPER_ADMIN_EMAIL=admin@vturb.com
SUPER_ADMIN_PASSWORD=Admin123456!

# [OBRIGATÓRIO] Configurações de Autenticação JWT
# Chave secreta de assinatura e tempo de expiração do token em horas (ex: 24h ou 24)
JWT_SECRET_KEY=sua-chave-secreta-super-segura-vturb-jwt-2026
JWT_ACCESS_TOKEN_EXPIRE_HOURS=24h


